# === Ambiente Python ===
venv/
.env
.env.*
__pycache__/
*.py[cod]
*$py.class

# === Configurações locais ===
# Um env por aparelho (config/env.emulator.yaml, config/env.real.yaml),
# com credenciais: fora do git. Os templates (*.example.yaml) seguem
# versionados. config/env.yaml é o formato antigo (um arquivo só).
config/env.yaml
config/env.*.yaml
!config/env.*.example.yaml
config/test_data.yaml
config/devices.yaml

# === Claude Code ===
# settings.json é versionado (bloqueia leitura dos env com credenciais);
# settings.local.json guarda preferências pessoais.
.claude/settings.local.json

# === Anotações locais ===
# Checkpoint pessoal de continuidade; o registro compartilhado fica em
# DECISOES.md.
ONDE_PAREI.md

# === Pytest e relatórios ===
.pytest_cache/
.cache/
# reports/ é gerado a cada execução, mas reports/assets/ guarda os
# arquivos versionados embutidos no report: o estilo (style.css) e o
# script da página (report.js).
reports/*
!reports/assets/

# === Logs ===
*.log

# === IDEs e editores ===
.vscode/
.idea/
*.swp

# === macOS ===
.DS_Store

# === Builds e arquivos temporários ===
dist/
build/
*.egg-info/
*.tmp
*.bak

# === Cobertura de testes ===
.coverage
htmlcov/

# === Aplicativos mobile ===
*.ipa
*.app
*.apk

# === Certificados e chaves ===
*.key
*.pem